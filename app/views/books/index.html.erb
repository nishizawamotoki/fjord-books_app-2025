<p style="color: green"><%= notice %></p>

<% content_for :title, "Books" %>

<h1><%= t('books.titles.index') %></h1>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>
    <p>
      <%= link_to t('books.links.show'), book %>
    </p>
  <% end %>
</div>

<%= link_to t('books.links.new'), new_book_path %>
